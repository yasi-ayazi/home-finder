{
    "name": "home-finder-server",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "npm run db:seed && npm run dev:watch",
        "dev:watch": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:unit": "vitest run --exclude src/db/**/*.test.ts",
        "test:db": "vitest run src/db",
        "db:migrate": "node-pg-migrate --migrations-dir src/db/migrations --migration-file-language ts up",
        "db:rollback": "node-pg-migrate --migrations-dir src/db/migrations --migration-file-language ts down",
        "db:seed": "tsx src/db/seed.ts"
    },
    "dependencies": {
        "@scalar/express-api-reference": "^0.10.17",
        "cors": "^2.8.6",
        "dotenv": "^17.2.3",
        "express": "^5.2.1",
        "pg": "^8.23.0",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^24.13.3",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^7.2.1",
        "eslint": "^10.9.1",
        "globals": "^17.12.0",
        "node-pg-migrate": "^9.0.0",
        "prettier": "^3.9.6",
        "supertest": "^7.2.2",
        "tsx": "^4.23.13",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.69.0",
        "vitest": "^4.1.11"
    }
}
